# Copy this file to .env and fill in values you need.
# Never commit the real .env file.

# youtubeapi: shared string required in ?key= or X-Api-Key header when set.
# Leave unset to allow all callers. This is not per-user authentication.
YT_KEY=

# youtubeapi: YouTube Internal API key appended to player and search requests.
# Leave unset to use the unkeyed endpoints, which work for most requests.
YOUTUBE_API_KEY=

# youtubeapi and tiktokapi: SHA-256 of the server SubjectPublicKeyInfo.
# Overrides the built-in pin for any host. Use hex, 32 bytes.
TLS_PIN_SHA256=

# youtubeapi and tiktokapi: set to 1 to allow unverified TLS for hosts
# without a built-in pin. Unsafe. Prefer setting TLS_PIN_SHA256 instead.
TLS_ALLOW_UNPINNED=

# youtubeapi: path to the Netscape cookie file. Defaults to cookies.txt.
YT_COOKIES=

# youtubeapi: bind address. Defaults to 127.0.0.1.
HOST=

# All services: listening port. Defaults are in the README.
PORT=
